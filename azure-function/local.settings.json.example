{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "ACS_CONNECTION_STRING": "endpoint=https://<your-acs-resource>.communication.azure.com/;accesskey=<key>",
    "ACS_SENDER_ADDRESS": "DoNotReply@<your-verified-domain>",
    "ENQUIRY_RECIPIENT": "info@ostify.co.uk",
    "ALLOWED_ORIGIN": "https://ostify.co.uk"
  }
}
